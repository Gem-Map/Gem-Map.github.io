---
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead 
			title={`${SITE_TITLE} - 앱 다운로드 QR 코드`} 
			description="Gemmap 모바일 앱 다운로드 QR 코드 페이지입니다. 카메라로 QR 코드를 스캔하면 해당 스마트폰 OS의 앱 스토어로 자동 연결됩니다." 
		/>
	</head>
	<body class="min-h-screen bg-gray-0 text-white flex flex-col items-center justify-center p-6 selection:bg-primary-40 selection:text-gray-0">
		<!-- Background Glow Effects -->
		<div class="fixed inset-0 overflow-hidden pointer-events-none -z-10">
			<div class="absolute -top-40 -left-40 w-96 h-96 bg-primary-40/20 rounded-full blur-3xl"></div>
			<div class="absolute -bottom-40 -right-40 w-96 h-96 bg-secondary-40/20 rounded-full blur-3xl"></div>
		</div>

		<main class="w-full max-w-sm bg-gray-10/80 backdrop-blur-xl border border-gray-90/30 rounded-3xl p-8 shadow-2xl text-center flex flex-col items-center">
			<!-- Header Badge -->
			<div class="inline-block px-3.5 py-1 mb-4 text-xs font-semibold tracking-wide uppercase bg-primary-20/30 text-primary-40 rounded-full">
				App Download QR
			</div>

			<h1 class="text-2xl font-extrabold tracking-tight mb-2">
				<span class="gem-gradient-text">{SITE_TITLE}</span> QR 코드
			</h1>
			<p class="text-gray-90 text-xs mb-6 leading-relaxed">
				스마트폰 카메라로 아래 QR 코드를 스캔하세요.<br />
				iOS는 App Store, Android는 Play Store로 자동 이동합니다.
			</p>

			<!-- QR Code Card -->
			<a 
				href="/download" 
				class="group relative block bg-white p-5 rounded-3xl shadow-xl border border-gray-90/20 transition-all duration-300 hover:scale-105 active:scale-95 mb-6"
				title="클릭 시 다운로드 페이지로 직접 이동합니다"
			>
				<img 
					src="/gemmap_qr.svg" 
					alt="Gemmap Download QR Code" 
					width="240" 
					height="240" 
					class="w-60 h-60 object-contain rounded-xl"
				/>
				<div class="absolute inset-0 bg-primary-40/10 opacity-0 group-hover:opacity-100 rounded-3xl transition-opacity duration-300 flex items-center justify-center">
					<span class="bg-gray-0/90 text-white text-xs font-bold px-3 py-1.5 rounded-full shadow">
						바로 가기 ➔
					</span>
				</div>
			</a>

			<!-- Action buttons -->
			<div class="w-full flex flex-col gap-2.5">
				<a 
					href="/download" 
					class="w-full py-3 px-4 rounded-xl bg-gradient-to-r from-primary-40 to-secondary-40 text-gray-0 font-bold text-sm shadow-lg shadow-primary-40/20 hover:opacity-95 transition-opacity"
				>
					스토어로 바로 이동하기 ➔
				</a>
				<a 
					href="/gemmap_qr.svg" 
					download="gemmap_qr.svg" 
					class="w-full py-2.5 px-4 rounded-xl bg-white/10 hover:bg-white/15 border border-white/10 text-gray-90 hover:text-white font-medium text-xs transition-colors"
				>
					QR 이미지 다운로드 (.svg)
				</a>
			</div>
		</main>

		<!-- Minimal Footer -->
		<footer class="mt-8 text-center text-xs text-gray-90">
			&copy; {new Date().getFullYear()} Gemmap. All rights reserved.
		</footer>
	</body>
</html>
