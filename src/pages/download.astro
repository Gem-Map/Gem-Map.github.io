---
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE, APP_STORE_URL, PLAY_STORE_URL } from '../consts';
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead 
			title={`${SITE_TITLE} - 앱 다운로드`} 
			description="Gemmap 모바일 앱 다운로드 페이지입니다. Android와 iOS 디바이스를 자동 감지하여 해당 스토어로 연결합니다." 
		/>
		<script is:inline define:vars={{ APP_STORE_URL, PLAY_STORE_URL }}>
			(function () {
				const userAgent = navigator.userAgent || navigator.vendor || window.opera;

				// Android OS detection
				if (/android/i.test(userAgent)) {
					window.location.replace(PLAY_STORE_URL);
					return;
				}

				// iOS detection (iPhone, iPad, iPod)
				if (/iPad|iPhone|iPod/.test(userAgent) && !window.MSStream) {
					window.location.replace(APP_STORE_URL);
					return;
				}
			})();
		</script>
	</head>
	<body class="min-h-screen bg-gray-0 text-white flex flex-col items-center justify-center p-6 selection:bg-primary-40 selection:text-gray-0">
		<!-- Background Glow Effects -->
		<div class="fixed inset-0 overflow-hidden pointer-events-none -z-10">
			<div class="absolute -top-40 -left-40 w-96 h-96 bg-primary-40/20 rounded-full blur-3xl"></div>
			<div class="absolute -bottom-40 -right-40 w-96 h-96 bg-secondary-40/20 rounded-full blur-3xl"></div>
		</div>

		<main class="w-full max-w-md bg-gray-10/80 backdrop-blur-xl border border-gray-90/30 rounded-3xl p-8 shadow-2xl text-center flex flex-col items-center">
			<!-- Logo Badge -->
			<div class="w-20 h-20 bg-gradient-to-br from-primary-40 to-secondary-40 rounded-2xl flex items-center justify-center shadow-lg shadow-primary-40/20 mb-6 group transition-transform duration-300 hover:scale-105">
				<svg class="w-10 h-10 text-gray-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
				</svg>
			</div>

			<h1 class="text-3xl font-extrabold tracking-tight mb-2">
				<span class="gem-gradient-text">{SITE_TITLE}</span>
			</h1>
			<p class="text-gray-90 text-sm mb-8 leading-relaxed">
				숨겨진 보석 같은 사진 스팟을 찾는 서비스.<br />
				스마트폰 디바이스에 맞는 스토어로 연결합니다.
			</p>

			<!-- Automatic Redirect Notice -->
			<div id="redirect-status" class="w-full mb-6 p-4 rounded-xl bg-gray-0/40 border border-gray-90/20 flex items-center justify-center gap-3 text-xs text-gray-90">
				<div class="w-4 h-4 border-2 border-primary-40 border-t-transparent rounded-full animate-spin"></div>
				<span>스토어로 이동하는 중입니다...</span>
			</div>

			<!-- Direct Download Buttons -->
			<div class="w-full flex flex-col gap-3.5 mb-8">
				<a 
					href={PLAY_STORE_URL} 
					target="_blank" 
					rel="noopener noreferrer" 
					class="w-full py-3.5 px-5 rounded-2xl bg-white/10 hover:bg-white/15 border border-white/10 flex items-center justify-center gap-3 font-semibold transition-all hover:scale-[1.02] active:scale-[0.98]"
				>
					<svg class="w-6 h-6 fill-current text-secondary-40" viewBox="0 0 24 24">
						<path d="M3,20.5V3.5C3,2.91 3.34,2.39 3.84,2.15L13.69,12L3.84,21.85C3.34,21.6 3,21.09 3,20.5M16.81,15.12L6.05,21.34L14.54,12.85L16.81,15.12M20.16,10.81C20.5,11.08 20.75,11.5 20.75,12C20.75,12.5 20.5,12.92 20.16,13.19L17.89,14.5L15.39,12L17.89,9.5L20.16,10.81M6.05,2.66L16.81,8.88L14.54,11.15L6.05,2.66Z" />
					</svg>
					<span>Google Play에서 받기</span>
				</a>

				<a 
					href={APP_STORE_URL} 
					target="_blank" 
					rel="noopener noreferrer" 
					class="w-full py-3.5 px-5 rounded-2xl bg-white/10 hover:bg-white/15 border border-white/10 flex items-center justify-center gap-3 font-semibold transition-all hover:scale-[1.02] active:scale-[0.98]"
				>
					<svg class="w-6 h-6 fill-current text-white" viewBox="0 0 24 24">
						<path d="M18.71,19.5C17.88,20.74 17,21.95 15.66,21.97C14.32,22 13.89,21.18 12.37,21.18C10.84,21.18 10.37,21.95 9.1,21.97C7.79,22 6.87,20.68 6.04,19.47C4.34,17 3.05,12.5 4.8,9.47C5.67,7.96 7.23,7 8.91,6.97C10.21,6.95 11.46,7.85 12.25,7.85C13.04,7.85 14.55,6.76 16.1,6.94C16.75,6.97 18.57,7.2 19.74,8.91C19.64,8.97 17.65,10.13 17.67,12.57C17.7,15.48 20.21,16.45 20.25,16.47C20.22,16.56 19.83,17.9 18.71,19.5M15.93,5.19C16.63,4.34 17.1,3.16 16.97,1.97C15.95,2.01 14.71,2.65 13.98,3.5C13.33,4.25 12.76,5.47 12.92,6.64C14.06,6.73 15.23,6.04 15.93,5.19Z" />
					</svg>
					<span>App Store에서 받기</span>
				</a>
			</div>

			<!-- QR Code Section for PC Users -->
			<div class="w-full pt-6 border-t border-gray-90/20 flex flex-col items-center">
				<p class="text-xs text-gray-90 mb-4">PC로 접속하셨나요? 카메라로 스캔하세요</p>
				<div class="bg-white p-3 rounded-2xl shadow-inner border border-gray-90/20">
					<img 
						src="/app_download_qr.svg" 
						alt="Gemmap Download QR Code" 
						width="160"
						height="160"
						class="rounded-lg"
					/>

				</div>
			</div>
		</main>

		<!-- Minimal Footer -->
		<footer class="mt-8 text-center text-xs text-gray-90">
			&copy; {new Date().getFullYear()} Gemmap. All rights reserved.
		</footer>

		<script is:inline>
			// UI update for Desktop / non-mobile visitors
			const userAgent = navigator.userAgent || navigator.vendor || window.opera;
			const isMobile = /android|iPad|iPhone|iPod/i.test(userAgent);
			
			if (!isMobile) {
				const statusEl = document.getElementById('redirect-status');
				if (statusEl) {
					statusEl.innerHTML = '<span>모바일 기기로 접근 시 해당 앱스토어로 자동 이동합니다.</span>';
				}
			}
		</script>
	</body>
</html>
