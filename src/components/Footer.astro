---
import { SITE_TITLE, SUPPORT_EMAIL } from '../consts';
const today = new Date();
---

<footer class="border-t border-gray-90/30 bg-white dark:border-gray-10/50 dark:bg-gray-0">
	<div class="mx-auto max-w-7xl px-6 py-16 lg:px-8">
		<div class="xl:grid xl:grid-cols-3 xl:gap-12">
			<div class="space-y-8">
				<a href="/" class="text-2xl font-black tracking-tighter">
					<span class="gem-gradient-text">{SITE_TITLE}</span>
				</a>
				<p class="text-sm leading-6 text-gray-50 dark:text-gray-90">
					숨겨진 보석 같은 사진 스팟을 찾는 여정.<br/>
					Gemmap과 함께 당신만의 특별한 장소를 기록하세요.
				</p>
			</div>
			<div class="mt-16 grid grid-cols-2 gap-8 xl:col-span-2 xl:mt-0">
				<div class="md:grid md:grid-cols-1 md:gap-8">
					<div>
						<h3 class="text-sm font-bold leading-6 text-gray-0 dark:text-white uppercase tracking-wider">Our Services</h3>
							<div class="flex flex-wrap items-center gap-4 mt-6">
								<a 
									href="https://play.google.com/store/apps/details?id=com.cheongha.gemmap.gem_map" 
									target="_blank" 
									rel="noopener noreferrer" 
									class="h-12 w-40 rounded-xl bg-gray-99 dark:bg-gray-10 flex flex-col justify-center px-5 border border-gray-90/50 transition-all duration-300 hover:scale-105 hover:border-primary-40 dark:hover:border-secondary-40 hover:shadow-md cursor-pointer no-underline group"
								>
									<span class="text-[8px] uppercase tracking-widest text-gray-50 dark:text-gray-90 group-hover:text-primary-40 dark:group-hover:text-secondary-40 transition-colors">GET IT ON</span>
									<span class="text-xs font-bold text-gray-0 dark:text-white group-hover:text-primary-40 dark:group-hover:text-secondary-40 transition-colors mt-0.5">Google Play</span>
								</a>
								<a 
									href="https://apps.apple.com/kr/app/gemmap-%EC%88%A8%EC%9D%80-%ED%8F%AC%ED%86%A0-%EC%8A%A4%ED%8C%9F-%EB%B0%9C%EA%B2%AC%ED%95%98%EA%B3%A0-%EC%B0%BE%EC%95%84%EA%B0%80%EA%B8%B0/id6754697654" 
									target="_blank" 
									rel="noopener noreferrer" 
									class="h-12 w-40 rounded-xl bg-gray-99 dark:bg-gray-10 flex flex-col justify-center px-5 border border-gray-90/50 transition-all duration-300 hover:scale-105 hover:border-primary-40 dark:hover:border-secondary-40 hover:shadow-md cursor-pointer no-underline group"
								>
									<span class="text-[8px] uppercase tracking-widest text-gray-50 dark:text-gray-90 group-hover:text-primary-40 dark:group-hover:text-secondary-40 transition-colors">Download on the</span>
									<span class="text-xs font-bold text-gray-0 dark:text-white group-hover:text-primary-40 dark:group-hover:text-secondary-40 transition-colors mt-0.5">App Store</span>
								</a>
							</div>
					</div>
				</div>
				<div class="md:grid md:grid-cols-1 md:gap-8">
					<div>
						<h3 class="text-sm font-bold leading-6 text-gray-0 dark:text-white uppercase tracking-wider">Connect</h3>
						<ul role="list" class="mt-6 space-y-4">
							<li>
								<a href="https://github.com/Gem-Map" class="text-sm leading-6 text-gray-50 hover:text-primary-40 dark:text-gray-90 dark:hover:text-secondary-40 transition-colors">GitHub</a>
							</li>
							<li>
								<a href="/rss.xml" class="text-sm leading-6 text-gray-50 hover:text-primary-40 dark:text-gray-90 dark:hover:text-secondary-40 transition-colors">RSS Feed</a>
							</li>
							{SUPPORT_EMAIL && (
								<li>
									<a href={`mailto:${SUPPORT_EMAIL}`} class="text-sm leading-6 text-gray-50 hover:text-primary-40 dark:text-gray-90 dark:hover:text-secondary-40 transition-colors">문의 및 지원</a>
								</li>
							)}
						</ul>
					</div>
				</div>
			</div>
		</div>
		<div class="mt-16 border-t border-gray-90/30 pt-8 dark:border-gray-10/50">
			<p class="text-xs leading-5 text-gray-50 dark:text-gray-90">&copy; {today.getFullYear()} Gemmap Team. All rights reserved.</p>
		</div>
	</div>
</footer>
